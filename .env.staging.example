# Staging server Mediasky (10.64.43.250, PHP 8.1, MySQL 8). Na serveru: cp .env.staging.example .env,
# upisati DB_PASSWORD iz ~/.my.cnf, pa chmod 600 .env i php artisan key:generate. Ovaj fajl ne sadrži tajne.
APP_NAME="Media Sky Project"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=http://10.64.43.250:8091

APP_LOCALE=bs
APP_FALLBACK_LOCALE=bs
APP_FAKER_LOCALE=bs_BA
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ensar_app
DB_USERNAME=ensar
DB_PASSWORD=

# Staging ne smije slati ništa van: mail ide u log, queue radi odmah (bez workera), nema crona.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mediasky.ba"
MAIL_FROM_NAME="${APP_NAME}"
QUEUE_CONNECTION=sync
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Server dozvoljava upload do 2 MB (upload_max_filesize), pa i aplikacija (u KB).
DOCUMENT_MAX_SIZE=2048

BACKUP_DISKS=backups

# Na stagingu nema crona (po dogovoru s adminom), pa bez upozorenja o scheduleru na svakoj stranici.
HEALTH_SCHEDULER_EXPECTED=false

# Server iznad stranice ubacuje traku "STAGING ENVIRONMENT"; sadržaj se pomjera ispod nje (px).
APP_TOP_BANNER_OFFSET=28

PROTOCOL_BASE_URL=
PROTOCOL_API_TOKEN=
PROTOCOL_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"
