APP_NAME="Media Sky Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=bs
APP_FALLBACK_LOCALE=bs
APP_FAKER_LOCALE=bs_BA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokalni razvoj: SQLite (fajl database/database.sqlite).
DB_CONNECTION=sqlite

# Produkcija (server s MySQL-om): zakomentarisati DB_CONNECTION=sqlite iznad i otkomentarisati ovo.
# Baza mora biti utf8mb4 (CREATE DATABASE media_sky_project CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci).
# Prenos postojećih podataka iz SQLite: php artisan app:copy-database sqlite mysql (vidi docs/PRODUCTION.md).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=media_sky_project
# DB_USERNAME=media_sky
# DB_PASSWORD=
# Folder s mysqldump ako nije u PATH-u (Windows), za app:backup:
# DB_DUMP_BINARY_PATH="C:/Program Files/MySQL/MySQL Server 8.0/bin"

# Backup (docs/PRODUCTION.md): lokalno + preporučeno udaljeno odredište
BACKUP_DISKS=backups
# BACKUP_LOCAL_PATH=
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_SFTP_HOST=
# BACKUP_SFTP_USERNAME=
# BACKUP_SFTP_PASSWORD=
# BACKUP_SFTP_ROOT=/backups/media-sky-project
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=eu-central-1
# BACKUP_S3_ENDPOINT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Buduća integracija s internim protokolom (Task 06)
PROTOCOL_BASE_URL=
PROTOCOL_API_TOKEN=
PROTOCOL_TIMEOUT=10
